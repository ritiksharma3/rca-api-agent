# Variable NAMES only. Put real values in your shell or a private .env (git-ignored).
API_AGENT_TOKEN=replace-me                # bearer token (--auth bearer)
API_AGENT_USERNAME=replace-me             # login credentials (--auth login)
API_AGENT_PASSWORD=replace-me
API_AGENT_API_KEY=replace-me              # API key (--auth api-key)
# Optional LLM assist for finding the login endpoint (--auth login / session). Skipped when unset or with --no-llm.
OPENROUTER_API_KEY=replace-me
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5   # any OpenRouter model id
